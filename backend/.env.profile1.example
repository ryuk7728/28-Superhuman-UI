APP_DEBUG=false
APP_ROLLOUT_BACKEND=local
APP_K_OVERRIDE=1

# Throughput/latency tradeoff for public profile
APP_ROLLOUTS=200
APP_WORKERS=2
APP_MAX_CONCURRENT_BOT_THINKING=2
APP_ROLLOUT_DEAL_RETRIES=30

# Keep logs quieter in production
APP_ROLLOUT_METRICS=0
APP_ROLLOUT_METRICS_INTERVAL=10

# CORS: set your production frontend domain.
# Add APP_CORS_ORIGIN_REGEX if you want Vercel preview deployments too.
APP_CORS_ORIGINS=https://your-frontend.vercel.app
APP_CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

